<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Bplay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/stage_backdrop</item>
        <item name="android:colorBackground">@color/stage_backdrop</item>
        <item name="android:statusBarColor">@color/stage_backdrop</item>
        <item name="android:navigationBarColor">@color/stage_backdrop</item>
    </style>

    <style name="Theme.Bplay.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/stage_backdrop</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_mark_backdrop</item>
        <item name="postSplashScreenTheme">@style/Theme.Bplay</item>
    </style>
</resources>
